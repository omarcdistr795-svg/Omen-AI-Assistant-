# Omen secrets — copy to .env (git-ignored). Never put real values in
# config.yaml, code, prompts, transcripts, logs, or memory.

# Cloud is disabled by default. Provide a key only if you explicitly enable a
# cloud adapter and raise the monthly budget in config.local.yaml.
OMEN_OPENAI_API_KEY=
OMEN_ANTHROPIC_API_KEY=

# Optional local model override (absolute path, used by future local adapters).
OMEN_LOCAL_MODEL_PATH=

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
OMEN_LOG_LEVEL=INFO

# Phase 3 (optional): keys for opt-in external MCP-style connectors.
# Leave empty to keep web/local-data tools fully offline (BLOCKED-EXTERNAL).
# Secrets belong here or in the OS keychain — never in config.yaml or code.
OMEN_WEB_CONNECTOR_KEY=
OMEN_CALENDAR_CONNECTOR_KEY=

# Phase 4 voice is local and uses no API keys. Speech models are configured
# by local paths in config.yaml/config.local.yaml, never in .env.

# Phase 5 automation is local-first and needs no new keys. If you later enable
# an external weather or build/deployment connector, put its key here (never in
# config.yaml, code, logs, prompts, tests or memory). Both stay disabled by
# default and are reported as BLOCKED-EXTERNAL until configured.
OMEN_WEATHER_CONNECTOR_KEY=
OMEN_BUILD_CONNECTOR_KEY=

# Phase 6 dashboard (local-only by default). Set a long random token before
# starting the dashboard. Never commit the real token.
OMEN_DASHBOARD_TOKEN=

# Optional secure phone access (only when explicitly enabled in config.local.yaml)
# requires TLS cert/key paths in config and allow_remote=true.
OMEN_DASHBOARD_TLS_CERT=
OMEN_DASHBOARD_TLS_KEY=

# Phase 7 release hardening adds no secrets or environment settings.
